# Copy to .env and fill in. See docs/project.md §9.

# LLM (D-014): "<provider>:<model>", e.g. openai:<model> or google_genai:<model>
KP_LLM_MODEL=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Seller's GST state code, used for place of supply (D-006)
KP_BUSINESS_STATE=CG

# Where DBs, PDFs and audio live
KP_STORAGE_DIR=storage

# Follow-up delay in hours (D-013); set small (e.g. 0.02) for demos
KP_FOLLOWUP_HOURS=48

# Comma-separated list or JSON array of allowed frontend origins
KP_CORS_ORIGINS=["http://localhost:3000"]

# Tracing (Phase 12)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
