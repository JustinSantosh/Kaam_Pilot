# Copy to .env and replace the owner password before using Business Ops.

# LLM (D-014, D-020). Demo mode needs no API key.
KP_LLM_MODEL=demo
OPENAI_API_KEY=
GOOGLE_API_KEY=
KP_LLM_TIMEOUT_SECONDS=30

# Owner session; use a long random password. Secure cookies must be enabled behind HTTPS.
KP_ENVIRONMENT=development
KP_OWNER_PASSWORD=replace-this-with-a-long-random-password
KP_OWNER_SESSION_TTL_SECONDS=28800
KP_OWNER_COOKIE_SECURE=false

# Seller's GST state code, used for place of supply (D-006)
KP_BUSINESS_STATE=CG

# Where DBs, PDFs and audio live
KP_STORAGE_DIR=storage

# Follow-up delay in hours (D-013); set small (e.g. 0.02) for demos
KP_FOLLOWUP_HOURS=48
KP_CHAT_RATE_LIMIT_PER_MINUTE=30
KP_SQLITE_BUSY_TIMEOUT_MS=5000

# Comma-separated list or JSON array of allowed frontend origins
KP_CORS_ORIGINS=["http://localhost:3000"]

# Quotation business details
KP_BUSINESS_NAME=Your Business Name
KP_BUSINESS_GSTIN=
KP_BUSINESS_ADDRESS=
KP_BUSINESS_PHONE=
KP_QUOTE_VALIDITY_DAYS=15
KP_ADVANCE_PERCENT=50

# Tracing (Phase 12)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
